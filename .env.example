# --- Required ---
# Token from @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# --- Optional: vision escalation (hybrid mode) ---
# Without a key the bot runs OCR-only. With one, frames that local OCR can't
# read are escalated to a vision model.
#
# Backend selection: "openai" (default) or "jev".
SIXSEVEN_VISION_PROVIDER=openai
OPENAI_API_KEY=
SIXSEVEN_VISION_MODEL=gpt-4o

# --- Optional: Jev (TypeSafe AI) backend ---
# Only used when SIXSEVEN_VISION_PROVIDER=jev. Jev is a decision model: it
# answers a typed yes/no with a calibrated probability instead of generating
# text. Image input is a TypeSafe "danger zone" feature (experimental).
#   gateway  -> Vercel AI Gateway (https://ai-gateway.vercel.sh/v1)
#   typesafe -> TypeSafe direct
TYPESAFE_API_KEY=
SIXSEVEN_JEV_PROVIDER=gateway
SIXSEVEN_JEV_MODEL=typesafe-ai/jev-1.14.0
SIXSEVEN_JEV_BASE_URL=https://ai-gateway.vercel.sh/v1
# Minimum probability to count as a match.
SIXSEVEN_JEV_THRESHOLD=0.85

# --- Optional: tuning (defaults shown) ---
SIXSEVEN_OCR_ENABLED=true
SIXSEVEN_OCR_LANGS=en
SIXSEVEN_VIDEO_FRAMES=4
SIXSEVEN_VISION_MAX_FRAMES=1
SIXSEVEN_DB_PATH=sixseven.db
SIXSEVEN_MAX_FILE_MB=20