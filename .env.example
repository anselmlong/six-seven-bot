# --- Required ---
# Token from @BotFather (https://t.me/BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# --- Optional: vision escalation (hybrid mode) ---
# Without this key the bot runs OCR-only. With it, frames that local OCR can't
# read are escalated to a Claude vision model.
ANTHROPIC_API_KEY=
SIXSEVEN_VISION_MODEL=claude-haiku-4-5

# --- Optional: tuning (defaults shown) ---
SIXSEVEN_OCR_ENABLED=true
SIXSEVEN_OCR_LANGS=en
SIXSEVEN_VIDEO_FRAMES=4
SIXSEVEN_VISION_MAX_FRAMES=1
SIXSEVEN_DB_PATH=sixseven.db
SIXSEVEN_MAX_FILE_MB=20
SIXSEVEN_SCAN_STICKERS=true
